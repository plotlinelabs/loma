# Loma backend
APP_NAME=Loma
# External origin users hit. With the bundled nginx proxy (docker compose) this is
# the proxy address: http://<your-ip> over HTTP, or https://<your-domain> once you
# enable TLS. For local dev without Docker (dashboard on :3001) use http://localhost:3001.
PUBLIC_BASE_URL=http://localhost
# Internal backend port — behind the proxy, not exposed externally by default.
WEBHOOK_PORT=3000

# Login methods the dashboard UI shows: local | google | local,google. BUILD-TIME
# (passed as a docker build arg), so set it here and `docker compose up -d --build`.
# Keep it equal to AUTH_PROVIDER in dashboard/.env. See dashboard/.env.example.
NEXT_PUBLIC_AUTH_PROVIDER=local

# --- HTTPS (optional) ---
# Default is HTTP on :80. To serve HTTPS on :443, get a cert and set these (see
# deploy/nginx/README.md), then `docker compose up -d`:
# LOMA_DOMAIN=loma.example.com
# COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml
# (and set PUBLIC_BASE_URL=https://loma.example.com above + AUTH_URL in dashboard/.env)
ENV=PROD
LOMA_SETUP_TOKEN=your-first-admin-setup-token

# Slack
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token

# Default model provider: OpenCode Go
# Create this key from OpenCode, then Loma will run opencode-go/deepseek-v4-flash by default.
OPENCODE_API_KEY=opencode-your-key
AGENT_DEFAULT_MODEL=opencode-go/deepseek-v4-flash
OPENCODE_PORT=4097
OPENCODE_HOST=127.0.0.1
AGENT_MAX_TURNS=500

# Optional Claude Agent SDK fallback. Set AGENT_DEFAULT_MODEL=anthropic/<model> to make Claude default.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# MongoDB for Loma observability/config
OBSERVABILITY_MONGODB_URI=mongodb+srv://user:pass@cluster.example.com/loma
OBSERVABILITY_DB_NAME=loma_observability

# Local disk storage for non-text skill assets. Back this directory up with MongoDB.
LOMA_SKILL_ASSET_DIR=/var/lib/loma/skill-assets

LOMA_SECRETS_DIR=/home/ubuntu/secrets

LOMA_WORKSPACE_DIR=/opt/loma-workspace

# Feature flags
LOMA_ENABLE_SCHEDULER=false
LOMA_ENABLE_WEBHOOKS=true
LOMA_ENABLE_METRICS=false
# Slack Socket Mode consumer (default true). Set false on preview/ephemeral stacks
# so they don't double-consume the production Slack app's events.
LOMA_ENABLE_SLACK=true
# Seed generic starter skills on first run when the skills collection is empty
# (default true). Existing deployments are untouched regardless.
LOMA_SEED_SKILLS=true

# Optional OAuth token encryption for personal integrations
OAUTH_ENCRYPTION_KEY=generate-a-fernet-key

# Optional web push for tasks-board notifications (leave blank to disable).
# Generate a key pair with: python -c "from py_vapid import Vapid; from py_vapid.utils import b64urlencode; v=Vapid(); v.generate_keys(); print(b64urlencode(v.private_key.private_numbers().private_value.to_bytes(32,'big')))"
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-company.com

# Optional integrations
GITHUB_API_KEY=
LINEAR_API_KEY=
LINEAR_WEBHOOK_SECRET=
HUBSPOT_ACCESS_TOKEN=
SENTRY_ACCESS_TOKEN=
SENTRY_ORG_SLUG=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/oauth/google/callback
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=http://localhost:3001/api/oauth/slack/callback

# Session-authenticated history recall; false is the emergency off switch.
# Issuer runs in the separate dashboard service, never in an agent process.
# Leave PUBLIC_KEY empty for automatic runtime issuance. Nonempty selects static API mode.
LOMA_RECALL_ENABLED=true
LOMA_RECALL_PUBLIC_KEY=
LOMA_RECALL_ISSUER_URL=http://loma-dashboard:3001

# Google Docs linking is available by default; set false for emergency shutdown.
# Linking remains opt-in per skill (regular skills unchanged).
LOMA_GOOGLE_DOCS_SKILLS_ENABLED=true

# Dedicated backend-only persistent artifact volume for isolated workers.
# Never mount this directory into worker containers. Downloads expire in 30 days.
# Run `python -m isolation.retention` daily with this configured path.
LOMA_WORKER_ARTIFACT_DIR=

# Remote worker cutover (all-or-nothing). LOMA_REMOTE_WORKERS=on routes every
# chat/flow/webhook/recovery agent run to the remote supervisor and disables
# local model CLI pools, prewarm and utility calls. Enable only after draining
# local runs; misconfiguration fails runs closed, never falls back locally.
# See docs/security-containment/remote-workers.md before enabling.
LOMA_REMOTE_WORKERS=
LOMA_WORKER_URL=
LOMA_WORKER_CONTROL_TOKEN=
LOMA_WORKER_TLS_CA=
LOMA_WORKER_TLS_CERT=
LOMA_WORKER_TLS_KEY=
# Subscription account candidates: comma-separated email=/absolute/config-dir.
LOMA_REMOTE_CLAUDE_ACCOUNTS=
LOMA_REMOTE_CODEX_ACCOUNTS=
# Optional OpenAI-compatible chat endpoint for non-subscription models.
LOMA_REMOTE_CHAT_ENDPOINT=
LOMA_REMOTE_CHAT_API_KEY=
LOMA_REMOTE_CHAT_API_KEY_HEADER=
# Model used when a run selects none, e.g. anthropic/claude-sonnet-4-5.
LOMA_REMOTE_DEFAULT_MODEL=
# Worst-case per-run model spend cap in integer nanodollars (default $20).
LOMA_REMOTE_RUN_BUDGET_NUSD=

# Remote automation grants: exact authenticated owners and exact repo/team IDs.
# No wildcard grants or inferred webhook owners. Provider keys stay on backend.
LOMA_REMOTE_AUTOMATION_GRANTS={}
# Example shape: {"user@example.test":{"github":["org/repo"],"linear":["team-uuid"]}}
LOMA_REMOTE_WEBHOOK_OWNERS={}
# Example shape: {"github":{"org/repo":"user@example.test"},"linear":{"team-uuid":"user@example.test"}}
